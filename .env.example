# Copy to .env and fill in only the services you install.
# Load this file into the shell environment before starting Claude Code.
# Setup and loading methods: docs/configuration.md
# Service-specific variables: docs/plugins/

# GitLab: set exactly one token variable.
GITLAB_URL='https://gitlab.com'
GITLAB_TOKEN='replace-with-personal-access-token'
# For read-only access, remove GITLAB_TOKEN above and use this instead:
# GITLAB_READ_TOKEN='replace-with-read-api-token'

# BookStack API token; write tools are disabled unless explicitly enabled.
BOOKSTACK_BASE_URL='https://bookstack.example.com'
BOOKSTACK_TOKEN_ID='replace-with-token-id'
BOOKSTACK_TOKEN_SECRET='replace-with-token-secret'
BOOKSTACK_ENABLE_WRITE='false'

# MediaWiki single-wiki configuration using Special:BotPasswords.
MEDIAWIKI_BASE_URL='https://wiki.example.com'
MEDIAWIKI_USERNAME='Admin@mcp'
MEDIAWIKI_PASSWORD='replace-with-bot-password'
